# ==========================================
# VR-SDS Enterprise .gitignore
# ==========================================

# 1. Ignore heavy dataset files (Audio & CSVs)
dataset/
*.wav
*.mp3
*.flac
*.csv

# 2. Ignore Python cache and virtual environments
__pycache__/
*.pyc
*.pyo
venv/
env/
.venv/

# 3. Ignore Docker Database Storage (Prevents leaking user data)
mysql_data/

# 4. Ignore Environment Variables (Security best practice)
.env

# 5. Ignore OS-generated hidden files
.DS_Store
Thumbs.db